# Optional overrides for the defaults in docker-compose.yml (copy to .env).
POSTGRES_PASSWORD=hospital_owner_dev
APP_DB_PASSWORD=hospital_app_dev
# The LLM key (never commit a real one); without it the Agent Orchestrator does not start.
OPENAI_API_KEY=
# The model the Model Selector uses (the default shown).
OPENAI_MODEL=gpt-5.6-luna
